# Cole Beats - automatisch gebaut aus beats/src/sample_chops.py, nicht direkt bearbeiten.
import flpianoroll as flp

# ---- Cole Beats Kern (wird in jedes Skript eingebaut) ----

NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']

SCALES = {
    'Moll': [0, 2, 3, 5, 7, 8, 10],
    'Dur': [0, 2, 4, 5, 7, 9, 11],
    'Harmonisch Moll': [0, 2, 3, 5, 7, 8, 11],
    'Phrygisch (dunkel)': [0, 1, 3, 5, 7, 8, 10],
    'Dorisch (smooth)': [0, 2, 3, 5, 7, 9, 10],
}
SCALE_NAMES = list(SCALES.keys())

# Akkordfolgen als Stufen (0 = Grundton-Akkord). Pro Takt ein Akkord.
PROGRESSIONS = {
    'Dark Trap': [0, 5, 6, 4],
    'Sad / Emotional': [0, 3, 5, 4],
    'Hoffnung': [5, 6, 0, 0],
    'Drill': [0, 0, 5, 4],
    'Hype': [0, 6, 5, 6],
    'Lo-Fi / Chill': [1, 4, 0, 5],
    'Afro / Happy': [0, 4, 5, 3],
    'R&B': [3, 4, 2, 5],
}
PROGRESSION_NAMES = list(PROGRESSIONS.keys())


class Rng:
    """Kleiner eigener Zufallsgenerator (gleicher Seed = gleiches Ergebnis)."""

    def __init__(self, seed):
        self.s = (int(seed) * 2654435761 + 1013904223) & 0xFFFFFFFF or 1

    def random(self):
        s = self.s
        s ^= (s << 13) & 0xFFFFFFFF
        s ^= s >> 17
        s ^= (s << 5) & 0xFFFFFFFF
        self.s = s & 0xFFFFFFFF
        return self.s / 4294967296.0

    def chance(self, p):
        return self.random() < p

    def randint(self, a, b):
        return a + int(self.random() * (b - a + 1))

    def choice(self, items):
        return items[int(self.random() * len(items))]


def root_note(octave, key):
    # Oktaven wie in FL Studio gezaehlt: C5 = MIDI 60
    return 12 * octave + key


def scale_note(root, scale, degree):
    n = len(scale)
    return root + 12 * (degree // n) + scale[degree % n]


def chord_notes(root, scale, degree, size=3):
    return [scale_note(root, scale, degree + 2 * i) for i in range(size)]


def voice_lead(prev, chord):
    """Waehlt die Umkehrung, die am naechsten am vorherigen Akkord liegt."""
    if not prev:
        return chord
    center = sum(prev) / len(prev)
    best, best_d = chord, None
    for inv in range(len(chord)):
        v = sorted(chord[inv:] + [x + 12 for x in chord[:inv]])
        for shift in (-12, 0, 12):
            vs = [x + shift for x in v]
            d = abs(sum(vs) / len(vs) - center)
            if best_d is None or d < best_d:
                best, best_d = vs, d
    return best


def progression_roots(key, scale_name, prog_name, bars):
    scale = SCALES[scale_name]
    prog = PROGRESSIONS[prog_name]
    return [(prog[b % len(prog)], scale) for b in range(bars)]


def ppq():
    return flp.score.PPQ


def add_note(number, time, length, velocity=0.8, slide=False):
    if number < 0 or number > 127 or length <= 0:
        return None
    n = flp.Note()
    n.number = int(number)
    n.time = int(time)
    n.length = int(length)
    n.velocity = max(0.05, min(1.0, velocity))
    if slide:
        try:
            n.slide = True
        except Exception:
            pass
    flp.score.addNote(n)
    return n


def clear_score():
    for i in range(flp.score.noteCount - 1, -1, -1):
        flp.score.deleteNote(i)


def add_common_inputs(form, with_prog=True):
    form.AddInputCombo('Tonart', NOTE_NAMES, 9)
    form.AddInputCombo('Skala', SCALE_NAMES, 0)
    if with_prog:
        form.AddInputCombo('Stimmung', PROGRESSION_NAMES, 0)
    form.AddInputCombo('Laenge', ['4 Takte', '8 Takte', '16 Takte'], 0)
    form.AddInputKnobInt('Variante (Seed)', 1, 1, 999)


def common_values(form, with_prog=True):
    key = form.GetInputValue('Tonart')
    scale_name = SCALE_NAMES[form.GetInputValue('Skala')]
    prog_name = PROGRESSION_NAMES[form.GetInputValue('Stimmung')] if with_prog else None
    bars = [4, 8, 16][form.GetInputValue('Laenge')]
    seed = form.GetInputValue('Variante (Seed)')
    return key, scale_name, prog_name, bars, seed

# ---- Ende Kern ----


# TITLE: Cole - Sample Chops
# INFO: Chop-Muster fuer Slicex / Fruity Slicer. Sample reinziehen, Slices machen, dieses Skript im Piano Roll starten.


STYLES = ['Der Reihe nach (Original-Feeling)', 'Random Flip', 'Stutter / Repeat', 'Hook-Loop (A A B A)',
          'Rueckwaerts-Flip', 'Half-Time (langsam, dunkel)']


def createDialog():
    form = flp.ScriptDialog('Cole - Sample Chops', 'Slicex legt Slice 1 auf C5. Anzahl Slices = so viele wie in Slicex.')
    form.AddInputKnobInt('Anzahl Slices', 8, 2, 32)
    form.AddInputCombo('Stil', STYLES, 1)
    form.AddInputCombo('Laenge', ['4 Takte', '8 Takte', '16 Takte'], 0)
    form.AddInputKnobInt('Variante (Seed)', 1, 1, 999)
    form.AddInputKnobInt('Start-Note (60 = C5)', 60, 0, 100)
    form.AddInputCheckbox('Alte Noten loeschen', True)
    return form


def build_chops(n_slices, style, bars, seed, P):
    rng = Rng(seed * 17 + style)
    s16 = P // 4
    out = []  # (slice_index, time, length)
    if style == 0:
        per = max(1, (16 * 4) // n_slices)  # 4 Takte decken alle Slices ab
        for b4 in range(0, bars, 4):
            for i in range(n_slices):
                t = b4 * 16 + i * per
                if t < (b4 + 4) * 16:
                    out.append((i, t * s16, per * s16))
    elif style in (1, 3, 4):
        phrase = []
        s = 0
        while s < 32:  # 2-Takt-Phrase
            length = rng.choice([2, 2, 4, 4, 1, 3, 6, 8])
            phrase.append((rng.randint(0, n_slices - 1), s, min(length, 32 - s)))
            s += length
        alt = [(rng.randint(0, n_slices - 1), s, l) for _, s, l in phrase]
        for b2 in range(0, bars, 2):
            use = alt if style == 3 and (b2 // 2) % 4 == 2 else phrase
            for idx, s, l in use:
                if style == 4:
                    idx = n_slices - 1 - idx
                out.append((idx, (b2 * 16 + s) * s16, l * s16))
    elif style == 2:
        for b in range(bars):
            s = 0
            while s < 16:
                idx = rng.randint(0, n_slices - 1)
                if rng.chance(0.4):
                    rep = rng.choice([2, 3, 4])
                    for k in range(rep):
                        if s < 16:
                            out.append((idx, (b * 16 + s) * s16, s16))
                            s += 1
                else:
                    l = rng.choice([2, 4])
                    out.append((idx, (b * 16 + s) * s16, min(l, 16 - s) * s16))
                    s += l
    else:
        for b in range(bars):
            for half in range(2):
                idx = rng.randint(0, n_slices - 1)
                out.append((idx, (b * 16 + half * 8) * s16, 8 * s16))
    return out


def apply(form):
    if form.GetInputValue('Alte Noten loeschen'):
        clear_score()
    start = form.GetInputValue('Start-Note (60 = C5)')
    bars = [4, 8, 16][form.GetInputValue('Laenge')]
    for idx, t, l in build_chops(form.GetInputValue('Anzahl Slices'), form.GetInputValue('Stil'), bars,
                                 form.GetInputValue('Variante (Seed)'), ppq()):
        add_note(start + idx, t, l, 0.85)
